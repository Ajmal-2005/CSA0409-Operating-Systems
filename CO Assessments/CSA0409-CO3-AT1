2. Paging Memory Management Scheme
Aim

To demonstrate the paging memory management scheme by dividing memory into fixed-size pages and frames and calculating the physical address using a page table.

Algorithm
Read the page size.
Read the number of pages and frames.
Enter the page table mapping each page to a frame.
Read the page number and offset.
Check whether the page number and offset are valid.
Obtain the corresponding frame number from the page table.
Calculate:

Physical Address = Frame Number × Page Size + Offset

C Program
#include <stdio.h>

int main() {
    int pages, frames, pageSize;
    int pageTable[100];
    int page, offset;
    int frame, physical;

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    printf("Enter page size: ");
    scanf("%d", &pageSize);

    printf("\nEnter Page Table Entries:\n");

    for (int i = 0; i < pages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("\nEnter Page Number: ");
    scanf("%d", &page);

    printf("Enter Offset: ");
    scanf("%d", &offset);

    if (page < 0 || page >= pages) {
        printf("\nInvalid Page Number.\n");
    }
    else if (offset < 0 || offset >= pageSize) {
        printf("\nInvalid Offset.\n");
    }
    else {
        frame = pageTable[page];

        if (frame < 0 || frame >= frames) {
            printf("\nInvalid Frame Number.\n");
        } else {
            physical = frame * pageSize + offset;

            printf("\nPage Number   : %d", page);
            printf("\nFrame Number  : %d", frame);
            printf("\nOffset        : %d", offset);
            printf("\nPhysical Address: %d\n", physical);
        }
    }

    return 0;
}

