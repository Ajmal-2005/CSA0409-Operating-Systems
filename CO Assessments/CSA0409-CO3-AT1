4. Translation Lookaside Buffer (TLB)
Aim

To simulate the working of a Translation Lookaside Buffer (TLB) and calculate the effective memory access time with and without TLB.

Algorithm
Read the memory access time.
Read the TLB lookup time.
Read the TLB hit ratio.
Calculate memory access time without TLB:

EAT without TLB = Memory Access Time

For a TLB hit:

TLB Hit Time = TLB Lookup Time + Memory Access Time

For a TLB miss:

TLB Miss Time = TLB Lookup Time + 2 × Memory Access Time

Calculate:

EAT = Hit Ratio × Hit Time + (1 − Hit Ratio) × Miss Time

C Program
#include <stdio.h>

int main() {
    float memoryTime, tlbTime;
    float hitRatio;
    float hitTime, missTime;
    float eatWithoutTLB, eatWithTLB;

    printf("Enter Memory Access Time (ns): ");
    scanf("%f", &memoryTime);

    printf("Enter TLB Lookup Time (ns): ");
    scanf("%f", &tlbTime);

    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f", &hitRatio);

    if (hitRatio < 0 || hitRatio > 1) {
        printf("\nInvalid Hit Ratio.\n");
        return 0;
    }

    eatWithoutTLB = 2 * memoryTime;

    hitTime = tlbTime + memoryTime;

    missTime = tlbTime + 2 * memoryTime;

    eatWithTLB = (hitRatio * hitTime) +
                 ((1 - hitRatio) * missTime);

    printf("\n----- TLB Performance -----\n");
    printf("Memory Access Time : %.2f ns\n", memoryTime);
    printf("TLB Lookup Time    : %.2f ns\n", tlbTime);
    printf("TLB Hit Ratio      : %.2f\n", hitRatio);

    printf("\nEffective Access Time without TLB: %.2f ns\n",
           eatWithoutTLB);

    printf("Effective Access Time with TLB   : %.2f ns\n",
           eatWithTLB);

    if (eatWithTLB < eatWithoutTLB)
        printf("\nTLB improves memory access time.\n");
    else
        printf("\nTLB does not improve memory access time.\n");

    return 0;
}

